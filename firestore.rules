rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'admin@elmago.com.tr';
    }

    function isBlocked() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUserFlags/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUserFlags/$(request.auth.uid)).data.blocked == true;
    }

    match /lostFoundListings/{listingId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.status == 'active';
      allow create: if signedIn() && !isBlocked()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 800
        && request.resource.data.city == 'Amasya'
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/listingRateLimits/$(request.auth.uid)).data.lastCreatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'kind', 'title', 'category', 'line', 'city', 'district', 'address',
          'location', 'coords', 'happenedAt', 'description', 'urgent',
          'ownerUid', 'ownerName', 'status', 'createdAt', 'updatedAt', 'expiresAt'
        ]);
      allow update: if isAdmin() || (signedIn() && !isBlocked()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'active' && request.resource.data.status == 'solved'))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 800
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'kind', 'title', 'category', 'line', 'city', 'district', 'address',
          'location', 'coords', 'happenedAt', 'description', 'urgent',
          'ownerName', 'status', 'updatedAt', 'expiresAt'
        ]));
      allow delete: if isAdmin() || (signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid));
    }

    match /listingRateLimits/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['lastCreatedAt'])
        && request.resource.data.lastCreatedAt == request.time;
      allow update: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['lastCreatedAt'])
        && request.resource.data.lastCreatedAt == request.time
        && resource.data.lastCreatedAt <= request.time - duration.value(24, 'h');
      allow delete: if false;
    }

    match /lostFoundContacts/{requestId} {
      allow create: if signedIn() && !isBlocked()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'chat'
        && request.resource.data.listingId is string
        && exists(/databases/$(database)/documents/lostFoundListings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/lostFoundListings/$(request.resource.data.listingId)).data.status == 'active'
        && request.resource.data.ownerUid == get(/databases/$(database)/documents/lostFoundListings/$(request.resource.data.listingId)).data.ownerUid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'listingId', 'listingTitle', 'ownerUid', 'requesterUid',
          'requesterName', 'status', 'typingUid', 'createdAt'
        ]);
      allow read: if isAdmin() || (signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid));
      allow update: if isAdmin() || (signedIn() && !isBlocked()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid)
        && ((request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['typingUid', 'typingAt'])
            && (request.resource.data.typingUid == request.auth.uid
              || request.resource.data.typingUid == null)
            && request.resource.data.typingAt is timestamp)
          || (resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == 'rejected'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'typingUid', 'typingAt', 'rejectedAt']))));
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid);

      match /messages/{messageId} {
        function contact() {
          return get(/databases/$(database)/documents/lostFoundContacts/$(requestId)).data;
        }
        function isParticipant() {
          return request.auth != null
            && (contact().ownerUid == request.auth.uid
              || contact().requesterUid == request.auth.uid);
        }
        allow read: if isParticipant();
        allow create: if !isBlocked() && isParticipant()
          && contact().status != 'rejected'
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() > 0
          && request.resource.data.ciphertext.size() <= 4096
          && request.resource.data.iv is string
          && request.resource.data.encryption == 'e2ee-v1'
          && request.resource.data.deliveredAt == null
          && request.resource.data.readAt == null
          && request.resource.data.keys().hasOnly(['senderUid', 'ciphertext', 'iv', 'encryption', 'createdAt', 'deliveredAt', 'readAt']);
        allow update: if isParticipant()
          && resource.data.senderUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt', 'readAt'])
          && (request.resource.data.deliveredAt == resource.data.deliveredAt || request.resource.data.deliveredAt == request.time)
          && (request.resource.data.readAt == resource.data.readAt || request.resource.data.readAt == request.time);
        allow delete: if isParticipant();
      }
    }

    match /lostFoundReports/{reportId} {
      allow create: if signedIn() && !isBlocked()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.keys().hasOnly([
          'listingId', 'listingTitle', 'reporterUid', 'reason', 'createdAt'
        ]);
      allow read, delete: if isAdmin() || (signedIn()
        && resource.data.reporterUid == request.auth.uid);
      allow update: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500;
      allow update, delete: if isAdmin();
    }

    match /pushDevices/{deviceId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.platform == 'ios'
        && request.resource.data.city == 'Amasya'
        && request.resource.data.enabled == true
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'token', 'platform', 'city', 'latitude', 'longitude',
          'enabled', 'updatedAt'
        ]);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'token', 'city', 'latitude', 'longitude', 'enabled', 'updatedAt'
        ]);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, delete: if signedIn() && userId == request.auth.uid;
      allow create, update: if false;
    }

    match /e2eeKeys/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['e2eePublicKey', 'e2eeVersion']);
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    match /adminUserFlags/{userId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /adminSettings/{settingId} {
      allow read: if isAdmin() || settingId == 'public';
      allow create, update, delete: if isAdmin();
    }

    match /adminAudit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
