rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'admin@elmago.com.tr';
    }

    function isBlocked() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUserFlags/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUserFlags/$(request.auth.uid)).data.blocked == true;
    }

    match /lostFoundListings/{listingId} {
      allow read: if true;
      allow create: if signedIn() && !isBlocked()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && !isBlocked()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid);
    }

    match /lostFoundContacts/{requestId} {
      allow create: if signedIn() && !isBlocked()
        && request.resource.data.requesterUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid));
      allow update: if isAdmin() || (signedIn() && !isBlocked()
        && (resource.data.ownerUid == request.auth.uid
          || ((resource.data.ownerUid == request.auth.uid
              || resource.data.requesterUid == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['typingUid', 'typingAt'])
            && (request.resource.data.typingUid == request.auth.uid
              || request.resource.data.typingUid == null)
            && request.resource.data.typingAt is timestamp)));
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid);

      match /messages/{messageId} {
        function contact() {
          return get(/databases/$(database)/documents/lostFoundContacts/$(requestId)).data;
        }
        function isParticipant() {
          return request.auth != null
            && (contact().ownerUid == request.auth.uid
              || contact().requesterUid == request.auth.uid);
        }
        allow read: if isAdmin() || isParticipant();
        allow create: if !isBlocked() && isParticipant()
          && contact().status != 'rejected'
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /lostFoundReports/{reportId} {
      allow create: if signedIn() && !isBlocked()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /adminUserFlags/{userId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /adminSettings/{settingId} {
      allow read: if isAdmin() || settingId == 'public';
      allow create, update, delete: if isAdmin();
    }

    match /adminAudit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
